# ==============================================================================
# Duolingo Speak - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your respective API keys.
# ==============================================================================

# Primary LLM API Key (Google Gemini - Required for AI Personas & Feedback)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs Multi-Key Auto-Rotation Pool (Comma-separated API Keys for High-Quality TTS)
ELEVENLABS_API_KEY=key_1_here,key_2_here

# Optional Local LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional Turso Cloud SQLite Persistence (Fallback to local data/custom_topics.db if empty)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
